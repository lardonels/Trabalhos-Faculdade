      "source": [
        "def createPB(shape, center, radius, lpType=2, n=2):\n",
        "    rows, cols = shape[:2]\n",
        "    r, c = np.mgrid[0:rows:1, 0:cols:1]\n",
        "    c -= center[0]\n",
        "    r -= center[1]\n",
        "    d = np.power(c, 2.0) + np.power(r, 2.0)     # D² = distância ao quadrado até o centro\n",
        "    lpFilter_matrix = np.zeros(shape, np.float32)\n",
        "    if lpType == 0:  # ideal\n",
        "        lpFilter = np.copy(d)\n",
        "        lpFilter[lpFilter < pow(radius, 2.0)] = 1\n",
        "        lpFilter[lpFilter >= pow(radius, 2.0)] = 0\n",
        "    elif lpType == 1:  # Butterworth\n",
        "        lpFilter = 1.0 / (1 + np.power(np.sqrt(d)/radius, 2*n))\n",
        "    elif lpType == 2:  # gaussiano\n",
        "        lpFilter = np.exp(-d/(2*pow(radius, 2.0)))\n",
        "    # 2 canais (real e imaginário) pq a cv2.dft guarda o espectro assim\n",
        "    lpFilter_matrix[:, :, 0] = lpFilter\n",
        "    lpFilter_matrix[:, :, 1] = lpFilter\n",
        "    return lpFilter_matrix\n",
        "\n",
        "def filtro_gaussiano(imagem, D0):\n",
        "    image_f32 = np.float32(imagem)\n",
        "    dft = cv2.dft(image_f32, flags=cv2.DFT_COMPLEX_OUTPUT)   # leva para a frequência\n",
        "    dft_shift = np.fft.fftshift(dft)                          # frequência zero vai para o centro\n",
        "    nrows, ncols = dft_shift.shape[:2]\n",
        "\n",
        "    maskPB = createPB(dft_shift.shape, center=(ncols // 2, nrows // 2), radius=D0, lpType=2)\n",
        "    filtered_freq = dft_shift * maskPB                        # aplica o filtro\n",
        "\n",
        "    f_ishift = np.fft.ifftshift(filtered_freq)                # desfaz o shift\n",
        "    img_back = cv2.idft(f_ishift)                             # volta para o espaço\n",
        "    img_back = cv2.magnitude(img_back[:, :, 0], img_back[:, :, 1])\n",
        "\n",
        "    # normaliza para 0-255\n",
        "    filtered_img = np.abs(img_back)\n",
        "    filtered_img -= filtered_img.min()\n",
        "    filtered_img = filtered_img * 255 / filtered_img.max()\n",
        "    filtered_img = filtered_img.astype(np.uint8)\n",
        "    return filtered_img, dft_shift, maskPB\n",
        "\n",
        "def limiarizar(imagem, T):\n",
        "    saida = np.zeros(imagem.shape, np.uint8)\n",
        "    saida[imagem > T] = 255\n",
        "    return saida\n",
        "\n",
        "# espectro e máscara para D0 = 80\n",
        "_, espectro, mascara = filtro_gaussiano(img, 80)\n",
        "magnitude = 20 * np.log(cv2.magnitude(espectro[:, :, 0], espectro[:, :, 1]) + 1)\n",
        "\n",
        "# cv2_imshow precisa de valores entre 0 e 255\n",
        "magnitude = magnitude * 255 / magnitude.max()\n",
        "mascara_img = mascara[:, :, 0] * 255       # a máscara vai de 0 a 1\n",
        "\n",
        "print('Espectro da original (esquerda) | Máscara gaussiana D0 = 80 (direita)')\n",
        "cv2_imshow(np.hstack([magnitude, mascara_img]))"
      ]
    },
