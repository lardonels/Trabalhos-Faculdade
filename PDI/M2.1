          "iopub.status.busy": "2026-10-20T19:01:29.909508Z",
          "iopub.status.idle": "2026-10-20T19:01:30.004548Z",
          "shell.execute_reply": "2026-10-20T19:01:30.002734Z"
        },
        "id": "49f0c621",
