        "def ampliar(imagem):\n",
        "    # recorta as linhas \"programs / only two digits / four to define\" e amplia 2x\n",
        "    # INTER_NEAREST repete os pixels, sem suavizar, pra dar pra ver as falhas\n",
        "    recorte = imagem[80:200, 20:260]\n",
        "    return cv2.resize(recorte, None, fx=2, fy=2, interpolation=cv2.INTER_NEAREST)\n",
        "\n",
        "def grade(a, b, c, d):\n",
        "    # monta 2x2: [a b] em cima e [c d] embaixo, com faixas cinza separando\n",
        "    sep_v = np.full((a.shape[0], 10), 128, np.uint8)\n",
        "    linha1 = np.hstack([a, sep_v, b])\n",
        "    linha2 = np.hstack([c, sep_v, d])\n",
        "    sep_h = np.full((10, linha1.shape[1]), 128, np.uint8)\n",
        "    return np.vstack([linha1, sep_h, linha2])\n",
        "\n",
        "print('Original | Dilatação (cruz 3x3)')\n",
        "print('Fechamento (cruz 3x3) | Gaussiano + limiar')\n",
