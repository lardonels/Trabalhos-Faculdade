      "source": [
        "texto = ('Historically, certain computer programs were written using only two digits '\n",
        "         'rather than four to define the applicable year. Accordingly, the company\\'s '\n",
        "         'software may recognize a date using \"00\" as 1900 rather than the year 2000.')\n",
        "\n",
        "esperado = 1  # começa em 1 por causa da moldura\n",
        "for letra in texto:\n",
        "    if letra == ' ':\n",
        "        continue\n",
        "    elif letra in 'ij\"':\n",
        "        esperado += 2   # pingo + corpo, ou as duas marcas da aspa\n",
        "    else:\n",
        "        esperado += 1\n",
        "print('grupos esperados:', esperado)\n",
        "\n",
        "def grupos(imagem):\n",
        "    # connectedComponents rotula cada grupo de pixels ligados (vizinhança-8)\n",
        "    # o rótulo 0 é o fundo por isso o -1\n",
        "    n, rotulos = cv2.connectedComponents((imagem > 0).astype(np.uint8), connectivity=8)\n",
        "    return n - 1\n",
        "\n",
        "def pixels_brancos(imagem):\n",
        "    return np.sum(imagem > 0)\n",
        "\n",
        "print('original -> grupos:', grupos(img), '| pixels brancos:', pixels_brancos(img))"
      ]
