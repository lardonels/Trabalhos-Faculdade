        "def sobel(imagem):\n",
        "    gx_k = np.array([[-1, 0, 1],\n",
        "                     [-2, 0, 2],\n",
        "                     [-1, 0, 1]])      # variação na horizontal\n",
        "    gy_k = np.array([[-1, -2, -1],\n",
        "                     [ 0,  0,  0],\n",
        "                     [ 1,  2,  1]])    # variação na vertical\n",
        "    img_f = imagem.astype(np.float32)\n",
        "    pad = np.pad(img_f, 1, mode='edge')    # repete a borda pra não criar borda falsa\n",
        "    alt, larg = imagem.shape\n",
        "    saida = np.zeros((alt, larg), np.float32)\n",
        "    for i in range(alt):\n",
        "        for j in range(larg):\n",
        "            janela = pad[i:i + 3, j:j + 3]\n",
        "            gx = np.sum(janela * gx_k)\n",
        "            gy = np.sum(janela * gy_k)\n",
        "            saida[i, j] = np.sqrt(gx ** 2 + gy ** 2)   # magnitude do gradiente\n",
        "    saida = saida * 255 / saida.max()      # normaliza pra 0-255\n",
        "    return saida.astype(np.uint8)\n",
        "\n",
        "dil_q11 = dilatacao(wire, elemento('quadrado', 11))\n",
        "\n",
        "borda_orig = sobel(wire)\n",
        "borda_ero = sobel(ero_q11)\n",
        "borda_dil = sobel(dil_q11)\n",
        "\n",
        "print('Original | Borda da original')\n",
        "print('Erodida (quadrado 11) | Borda da erodida')\n",
        "cv2_imshow(grade(wire, borda_orig, ero_q11, borda_ero))\n",
        "print('Dilatada (quadrado 11) | Borda da dilatada')\n",
        "sep = np.full((wire.shape[0], 10), 128, np.uint8)\n",
        "cv2_imshow(np.hstack([dil_q11, sep, borda_dil]))"
