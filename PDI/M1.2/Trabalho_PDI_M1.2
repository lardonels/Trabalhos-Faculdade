        "# Reutilizei a convolução e removi o np.clip pois o Laplaciano necessita do tipo Float para rodar corretamente\n",
        "def convolucao_float(img, kernel):\n",
        "  #convolucao_float() mantém o resultado como float32, preservando valores negativos e decimais\n",
        "  k = kernel.shape[0] // 2\n",
        "#pega o tamanho do kernel e calcula o raio dele\n",
        "  f = img.astype(np.float32)\n",
        "  pad = np.pad(f, k, mode='edge') #adiciona uma borda ao redor da imagem\n",
        "#mode='edge' significa que os valores da borda são repetidos\n",
        "  saida = np.zeros_like(f) #cria matriz de 0 q vai armazenar resultado da convolução\n",
        "  for y in range(f.shape[0]):\n",
        "    for x in range(f.shape[1]):\n",
        "      #pega uma pequena região da imagem do mesmo tamanho do kernel\n",
        "      regiao = pad[y:y+kernel.shape[0], x:x+kernel.shape[1]]\n",
        "      #faz multiplicação elemento por elemento e soma todos os resultados (operação da convolução)\n",
        "      saida[y, x] = (regiao * kernel).sum()\n",
        "\n",
        "  return saida #retorna a matriz resultante sem transformar em uint8 e sem limitar entre 0 e 255\n",
        "#kernel Laplaciano 3×3 usado no projeto\n",
        "lap = np.array([[0, 1, 0], [1, -4, 1], [0, 1, 0]], dtype=np.float32)\n",
        "#cria uma função que vai transformar a resposta do Laplaciano em um único número de nitidez\n",
        "def nitidez(img):\n",
        "  resposta = convolucao_float(img, lap)\n",
        "  #aplica laplaciano e devolve uma matriz do mesmo tamanho da imagem\n",
        "  valor = resposta.var()\n",
        "  #resume o mapa num numero\n",
        "  #usamos variância do Laplaciano como medida numérica de nitidez\n",
        "  return valor\n",
        "\n",
        "print(f\"{'imagem':<10}{'orig':>9}{'degrad':>9}{'equaliz':>9}{'suaviz':>9}{'k=1':>9}{'k=3':>9}\")\n",
        "for i, nome in enumerate(nomes):\n",
        "  etapas = [imagens[i], degradadas[i], equalizadas[i],\n",
        "            suavizadas[i], realcadas[i], realcadas_k3[i]] #seis versões correspondentes da mesma img\n",
        "  vals = [nitidez(e) for e in etapas] #calcula a variância do Laplaciano para cada uma das seis img\n",
        "  print(f\"{nome:<10}\" + \"\".join(f\"{v:>9.1f}\" for v in vals))"
      ],
