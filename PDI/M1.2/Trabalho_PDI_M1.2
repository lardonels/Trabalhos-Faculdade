        "#criando imagem degradada com ruído gaussiano\n",
        "np.random.seed(42)\n",
        "#fixa o valor pra nao mudar toda vez que roda a celula\n",
        "\n",
        "def ruido_gauss(img, sigma): # sigma é o parâmetro que controla a intensidade do ruído\n",
        "  f = img.astype(np.float32)\n",
        "  #necessario pra ruido gaussiano, que gera valores negativos\n",
        "  ruido = np.random.normal(0, sigma, img.shape) # gerando uma matriz de ruído com distribuição normal (gaussiana)\n",
        "  #media 0 = brilho medio da imagem nao muda, sigma é o desvio\n",
        "  #img.shape: devolve a matriz do mesmo tamanho pronta pra soma elemento a elemento\n",
        "  deg = f + ruido #pixel original + ruído\n",
        "  #cria a imagem degradada\n",
        "  deg = np.clip(deg, 0, 255)\n",
        "  #limita os valores em 0 a 255\n",
        "  img_deg = np.round(deg).astype(np.uint8) #arredonda os valores e converte p uint8\n",
        "\n",
        "  return img_deg\n",
        "\n",
        "degradadas = [ruido_gauss(im, 10) for im in imagens] #for para aplicar pras 3 img\n",
        "\n",
        "print(f\"{'imagem':<10}{'sigma_nom':>11}{'sigma_med':>11}{'media':>8}\")\n",
        "for nome, orig, deg in zip(nomes, imagens, degradadas): #compara original a degradada\n",
        "    diff = deg.astype(np.float32) - orig.astype(np.float32)\n",
        "    print(f\"{nome:<10}{10:>11}{diff.std():>11.2f}{diff.mean():>8.2f}\")"
      ],
