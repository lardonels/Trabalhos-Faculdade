        "# implementando a convolução espacial\n",
        "def convolucao(img, kernel): #kernel → matriz do filtro\n",
        "  k = kernel.shape[0] // 2\n",
        "  #descobre o raio do kernel\n",
        "#precisa saber quanto aumentar a borda da imagem para conseguir aplicar o kernel também nos pixels das extremidades\n",
        "  f = img.astype(np.float32)\n",
        "  pad = np.pad(f, k, mode='edge')\n",
        "  #cria a borda pelo padding por replicação\n",
        "  #mode=edge replica a ultima linha/coluan sem introduzir valores que nao existem na imagem\n",
        "#simplificando: replica os valores que estão na borda da imagem\n",
        "  saida = np.zeros_like(f) #cria matriz de 0 com msm tamanho e tipo de dados q f\n",
        "  for y in range(f.shape[0]): #f.shape[0] representa o número de linhas da imagem\n",
        "    for x in range(f.shape[1]):\n",
        "      regiao = pad[y:y+kernel.shape[0], x:x+kernel.shape[1]]\n",
        "      #fatiamento: recorta a janela da imagem preenchida, como pad tem k linhas a mais no topo, a janela que começa em y ta centrada no pixel y da imagem original\n",
        "      #deslocamento se cancela sozinho, nao precisa somar k em lugar nenhum\n",
        "      saida[y, x] = (regiao * kernel).sum()\n",
        "      #regiao * kernel é multiplicação de elemento por elemento (nao produto matricial)\n",
        "\n",
        "  img_conv = np.clip(saida, 0, 255).round().astype(np.uint8)\n",
        "\n",
        "  return img_conv"
      ],
