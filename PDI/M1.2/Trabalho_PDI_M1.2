    {
      "cell_type": "code",
      "source": [
        "#cria o kernel Gaussiano\n",
        "def kernel_gauss(tam, sigma): #sigma → controla o quanto o desfoque será espalhado\n",
        "  k = tam // 2 #calcula quantas posições existem de cada lado do centro\n",
        "  y, x = np.mgrid[-k:k+1, -k:k+1]\n",
        "  #np.mgrid cria duas matrizes com as coordenadas (x,y) relativas ao centro\n",
        "  g = np.exp(-(x**2 + y**2) / (2 * sigma**2)) #constrói o filtro Gaussiano (formula)\n",
        "  gnorm = g / g.sum() #g.sum() soma todos os pesos do kernel e divide cada elemento pelo total\n",
        "  #divisão extremamente necessária, os pesos precisam somar 1, se nao o filtro altera o brilho medio da imagem\n",
        "  return gnorm #devolve o kernel Gaussiano já normalizado"
      ],
