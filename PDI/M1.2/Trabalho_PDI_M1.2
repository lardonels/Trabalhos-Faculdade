        "#calculando o PSNR (Peak Signal-to-Noise Ratio) em decibéis para comparar a imagem original com cada etapa do processamento\n",
        "def conv_db(orig, proc):\n",
        "  a = orig.astype(np.float32)\n",
        "  b = proc.astype(np.float32)\n",
        "  mse = ((a - b) ** 2).mean() #calcula o Erro Quadrático Médio\n",
        "  #a-b é a matriz de diferenças, positiva onde a processada escureceu e negativa onde clareou\n",
        "  #**2 eleva cada diferença ao quadrado, aumentando erros grandes e elimina o sinal\n",
        "  #.mean faz a média sobre todos os pixels\n",
        "  if mse == 0: #verifica se o erro é exatamente zero\n",
        "    return float('inf')\n",
        "    #em caso de imagens iguais\n",
        "    #o PSNR tende ao infinito quando duas imagens são exatamente iguais\n",
        "\n",
        "  conv = 10 * np.log10(255**2 / mse)\n",
        "  #razão entre o sinal maximo possivel ao quadrado e o erro. erro<, >razao\n",
        "  return conv #retorna o valor do PSNR em decibéis\n",
        "\n",
        "print(f\"{'imagem':<10}{'degrad':>9}{'equaliz':>9}{'suaviz':>9}{'k=1':>9}{'k=3':>9}\")\n",
        "for i, nome in enumerate(nomes):\n",
        "    etapas = [degradadas[i], equalizadas[i], suavizadas[i],\n",
        "              realcadas[i], realcadas_k3[i]]\n",
        "    vals = [conv_db(imagens[i], e) for e in etapas]\n",
        "    print(f\"{nome:<10}\" + \"\".join(f\"{v:>9.2f}\" for v in vals))"
      ],
