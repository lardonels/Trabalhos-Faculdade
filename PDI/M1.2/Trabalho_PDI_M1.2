        "#realçar detalhes\n",
        "def realc(img, suave, k): #suave → versão suavizada/borrada dessa imagem\n",
        "#k → fator que controla a intensidade do realce\n",
        "  #recebe duas imagens, normal e uma borrada\n",
        "  f = img.astype(np.float32)\n",
        "  s = suave.astype(np.float32)\n",
        "  mascara = f - s\n",
        "  #isola os detalhes finos que o borramento apaga\n",
        "  out = f + k * mascara\n",
        "  #ao somar de volta na imagem, realça os detalhes\n",
        "  return np.clip(out, 0, 255).round().astype(np.uint8)\n",
        "#arante que nenhum pixel fique fora da faixa válida arredonda e converte\n",
        "realcadas = [] #cria uma lista vazia que vai armazenar as imagens realçadas k=1.0\n",
        "realcadas_k3 = [] #lista vazia, dessa vez para armazenar as imagens k=3.0\n",
        "for su in suavizadas:\n",
        "  su2 = convolucao(su, kg) #su já é uma imagem suavizada mas aplica o msm filtro e ela fica mais suavizada ainda\n",
