        "#equalização de histograma, basciamente redistribuir os níveis de intensidade para tentar melhorar o contraste da imagem\n",
        "def equaliza(img):\n",
        "#uma maneira mais demorada de passar pela imagem porem mais clara e facil de entender, ao inves de usar um bincount\n",
        "  hist = np.zeros(256, dtype=np.int64)\n",
        "  #cria um array vazio com uma posição por nivel de cinza e, como vem como float, tranforma em int\n",
        "  for v in range(256):\n",
        "    hist[v] = (img == v).sum()\n",
        "    #compara elemento por elemento, devolve matriz booleana do mesmo shape da imagem, true onde o pixel vale v, depois conta os true (sum)\n",
        "#basicamente compara cada pixel da img com valor de v e soma (comentario do leo mto complicado rs)\n",
        "  cdf = np.cumsum(hist) #CDF — função de distribuição acumulada\n",
        "  #cumsum devolve array onde cada posição é a soma de tudo até ali. cdf[255] é o total de pixels da imagem\n",
        "\n",
        "  cdf_min = cdf[cdf > 0].min()\n",
        "  #cdf_min = menor contagem acumulada\n",
        "  #[cdf > 0] é a indexação (\"mascara\") booleana (seleciona os positivos) e pega o menor\n",
        "  total = img.size\n",
        "  #transforma a CDF em um mapa de novos níveis de intensidade\n",
        "  mapa = np.round((cdf - cdf_min) / (total - cdf_min) * 255)\n",
        "  #normalizando pra faixa de saida\n",
        " # cdf - cdf_min desloca a CDF para considerar o primeiro valor acumulado relevante como referência\n",
        " # / (total - cdf_min) normaliza os valores em relação ao número total de pixels\n",
        " # * 255 expande a escala para faixa de uma imagem uint8\n",
        " # np.round arredonda os valores pq pode vir num decimal\n",
        "  img_eq = mapa[img].astype(np.uint8) #cada pixel é substituído pelo valor correspondente no mapa\n",
        "  #indexa a array de 256 posições com uma matriz de valores, devolvendo uma matriz do mesmo shape, com cada pixel substituido pelo valor correspondente da tabela\n",
        "\n",
        "  return img_eq\n",
        "\n",
        "equalizadas = [equaliza(d) for d in degradadas] #aplica a função às três imagens degradadas\n",
        "eq_originais = [equaliza(im) for im in imagens] #faz a mesma coisa, mas nas imagens originais\n",
        "\n",
        "fig, axes = plt.subplots(3, 3, figsize=(14, 12))\n",
        "#cria a visualização\n",
        "for i, (nome, deg, eq) in enumerate(zip(nomes, degradadas, equalizadas)):\n",
        "  axes[i, 0].imshow(deg, cmap='gray', vmin=0, vmax=255)\n",
        "  axes[i, 0].set_title(f'{nome} - degradada')\n",
        "  axes[i, 0].axis('off')\n",
        "\n",
        "  axes[i, 1].imshow(eq, cmap='gray', vmin=0, vmax=255)\n",
        "  axes[i, 1].set_title(f'{nome} - equalizada')\n",
        "  axes[i, 1].axis('off')\n",
        "\n",
        "  axes[i, 2].hist(deg.ravel(), bins=256, range=(0, 256), alpha=0.6, label='degradada')\n",
