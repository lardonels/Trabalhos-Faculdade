        "def erosao(mascara, n):\n",
        "    altura, largura = mascara.shape # recupera a altura e a largura da máscara\n",
        "    r = n // 2 # calcula o tamanho da borda necessário para aplicar a operação\n",
        "    borda = np.pad(mascara, r, constant_values=True) # adiciona uma borda branca ao redor da imagem\n",
        "    saida = np.ones((altura, largura), dtype=bool) # cria a máscara de saída inicialmente preenchida com True\n",
        "\n",
        "    for dl in range(n): # percorre as linhas da vizinhança\n",
        "        for dc in range(n): # percorre as colunas da vizinhança\n",
        "            saida &= borda[dl:dl + altura, dc:dc + largura]#E: mantém o pixel como True somente se todos os pixels da vizinhança forem True\n",
        "    return saida # retorna a máscara após a erosão\n",
        "\n",
        "def dilatacao(mascara, n):\n",
        "    altura, largura = mascara.shape #recupera a altura e a largura da máscara\n",
        "    r = n // 2 #calcula o tamanho da borda necessário para aplicar a operação\n",
        "    borda = np.pad(mascara, r, constant_values=False) #adiciona uma borda preta ao redor da imagem\n",
        "    saida = np.zeros((altura, largura), dtype=bool) #cria a máscara de saída inicialmente preenchida com False\n",
        "    for dl in range(n): #percorre as linhas da vizinhança\n",
        "        for dc in range(n): #percorre as colunas da vizinhança\n",
        "            saida |= borda[dl:dl + altura, dc:dc + largura]#ou define o pixel como True se pelo menos um pixel da vizinhança for True\n",
        "    return saida #retorna a máscara após a dilatação\n",
        "def abertura(mascara, n):\n",
        "    return dilatacao(erosao(mascara, n), n) #aplica primeiro a erosão e depois a dilatação para remover pequenos ruídos\n",
        "def fechamento(mascara, n):\n",
        "    return erosao(dilatacao(mascara, n), n) #aplica primeiro a dilatação e depois a erosão para preencher pequenos buracos\n",
        "m = np.random.RandomState(0).rand(60, 80) > 0.5 #gera uma máscara aleatória de 60x80 pixels, com valores True e False\n",
        "ee = np.ones((5, 5), np.uint8) #cria um elemento estruturante de 5x5 pixels para usar na comparação com o OpenCV\n",
        "print('erosão igual ao OpenCV:   ', np.array_equal(erosao(m, 5), cv2.erode(m.astype(np.uint8), ee) > 0))\n",
        "#compara o resultado da erosão implementada com o resultado do OpenCV\n",
        "print('dilatação igual ao OpenCV:', np.array_equal(dilatacao(m, 5), cv2.dilate(m.astype(np.uint8), ee) > 0))\n",
        "#compara o resultado da dilatação implementada com o resultado do OpenCV"
      ]
    },
