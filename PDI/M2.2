        "#função que converte uma imagem do formato BGR para HSV manualmente\n",
        "def rgb_para_hsv(img):\n",
        "\n",
        "    #os canais BGR originais variam de 0 a 255, normaliza os valores para o intervalo de 0 a 1, como a imagem foi carregada pelo OpenCV, a ordem dos canais é BGR\n",
        "    b = img[:, :, 0] / 255.0\n",
        "    g = img[:, :, 1] / 255.0\n",
        "    r = img[:, :, 2] / 255.0\n",
        "\n",
        "    #encontra o maior valor entre os canais R, G e B de cada pixel\n",
        "    maximo = np.maximum(np.maximum(r, g), b)\n",
        "\n",
        "    #encontra o menor valor entre os canais R, G e B de cada pixel\n",
        "    minimo = np.minimum(np.minimum(r, g), b)\n",
        "\n",
        "    #calcula a diferença entre o maior e o menor canal e essa diferença é utilizada nos cálculos de matiz e saturação\n",
        "    delta = maximo - minimo\n",
        "\n",
        "    #cria a matriz da matiz (H), inicialmente preenchida com zeros\n",
        "    h = np.zeros_like(maximo)\n",
        "\n",
        "    #identifica os pixels que possuem alguma cor pixels em tons de cinza possuem delta igual a zero e ficam com H = 0\n",
        "    tem_cor = delta > 0\n",
        "\n",
        "    #seleciona os pixels em que o vermelho é o maior canal\n",
        "    m = tem_cor & (maximo == r)\n",
        "\n",
        "    #calcula a matiz dos pixels em que o vermelho é o maior canal o módulo 360 mantém os valores dentro do intervalo de 0 a 360 graus\n",
        "    h[m] = (60 * (g[m] - b[m]) / delta[m]) % 360\n",
        "\n",
        "    #seleciona os pixels em que o verde é o maior canal a condição maximo != r trata os casos de empate entre canais\n",
        "    m = tem_cor & (maximo == g) & (maximo != r)\n",
        "\n",
        "    #calcula a matiz dos pixels em que o verde é o maior canal o acréscimo de 120 graus posiciona o resultado no setor do verde\n",
        "    h[m] = 60 * (b[m] - r[m]) / delta[m] + 120\n",
        "\n",
        "    #seleciona os pixels em que o azul é o maior canal as condições adicionais tratam os empates com vermelho e verde\n",
        "    m = tem_cor & (maximo == b) & (maximo != r) & (maximo != g)\n",
        "\n",
        "    #calcula a matiz dos pixels em que o azul é o maior canal o acréscimo de 240 graus posiciona o resultado no setor do azul\n",
        "    h[m] = 60 * (r[m] - g[m]) / delta[m] + 240\n",
        "\n",
        "    #cria a matriz da saturação (S), inicialmente preenchida com zeros\n",
        "    s = np.zeros_like(maximo)\n",
        "\n",
        "    #calcula a saturação somente para pixels cujo valor máximo é maior que zero a condição evita divisão por zero em pixels totalmente pretos\n",
        "    s[maximo > 0] = delta[maximo > 0] / maximo[maximo > 0]\n",
        "\n",
        "    #retorna a matiz (H), a saturação (S) e o valor/brilho (V)\n",
        "    return h, s, maximo\n",
        "#carrega a imagem do rosto e redimensiona seu maior lado para 400 pixels\n",
        "teste = ler('face1.jpg', 400)\n",
        "#realiza a conversão manual da imagem BGR para HSV armazena separadamente os canais H (matiz), S (saturação) e V (brilho)\n",
        "h, s, v = rgb_para_hsv(teste)\n",
        "#realiza a conversão da mesma imagem utilizando a função do OpenCV astype(float) converte os valores para números de ponto flutuante\n",
        "hsv_cv = cv2.cvtColor(teste, cv2.COLOR_BGR2HSV).astype(float)\n",
        "#calcula a diferença entre as matizes das duas conversões, divide H por 2 para adaptar a escala manual (0 a 360) à escala do OpenCV (0 a 180)\n",
        "dif_h = np.abs(h / 2 - hsv_cv[:, :, 0])\n",
        "#ajusta a diferença considerando que a matiz é circular assim, valores próximos de 0 e 180 são tratados como próximos entre si\n",
        "dif_h = np.minimum(dif_h, 180 - dif_h)\n",
        "#exibe a maior diferença encontrada na matiz e na saturação\n",
        "#a saturação manual é multiplicada por 255 para utilizar a mesma escala do OpenCV, .max() encontra a maior diferença e .round(2) arredonda para duas casas decimais\n",
        "print(\n",
        "    'maior diferença em H (graus/2):',\n",
        "    dif_h.max().round(2),\n",
        "    '| em S (0..255):',\n",
        "    np.abs(s * 255 - hsv_cv[:, :, 1]).max().round(2)\n",
        ")\n"
      ]
