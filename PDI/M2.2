      "source": [
        "#calcula o Coeficiente de Silhueta (Silhouette Score) para avaliar a qualidade dos agrupamentos produzidos pelo K-means\n",
        "#basicamente serve pra comparar numericamente qual abordagem formou agrupamentos mais bem definidos\n",
        "#diferente das células anteriores, que mostravam os resultados visualmente, aqui tem uma avaliação quantitativa da segmentação\n",
        "print(f'{\"imagem\":21s} {\"K\":>2s} {\"silhueta A (RGB)\":>17s} {\"silhueta B (RGB+XY)\":>20s}')\n",
        "for nome, r in resultados.items():\n",
        "    idx = np.random.RandomState(1).choice(r['img'].shape[0] * r['img'].shape[1], 3000, replace=False) #seleciona aleatoriamente 3000 pixels da imagem sem repetição, semente 1 garante que a seleção seja reproduzível\n",
        "    sil_a = silhouette_score(caracteristicas(r['img'], False)[idx], r['rot_a'].reshape(-1)[idx])#calcula o coeficiente de silhueta da abordagem A (somente RGB)\n",
        "    #false indica que serão utilizadas apenas as características de cor\n",
        "    sil_b = silhouette_score(caracteristicas(r['img'], True)[idx], r['rot_b'].reshape(-1)[idx])#calcula o coeficiente de silhueta da abordagem B (RGB+XY)\n",
        "    #true indica que serão utilizadas as cores e as coordenadas espaciais\n",
        "    r['sil'] = (sil_a, sil_b) #armazena os dois resultados de silhueta no dicionário da imagem, o primeiro valor corresponde ao RGB e o segundo ao RGB+XY\n",
        "    print(f'{nome:21s} {r[\"k\"]:2d} {sil_a:17.2f} {sil_b:20.2f}')"
