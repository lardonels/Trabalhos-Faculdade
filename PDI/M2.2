        "def saturacao(cor):\n",
        "    mx, mn = max(cor), min(cor) #recupera o maior e o menor valor entre os canais de cor\n",
        "    return 0 if mx == 0 else (mx - mn) / mx #calcula a saturação da cor, evitando divisão por zero\n",
        "\n",
        "def mascara_macas(rotulos, cores):\n",
        "    grupos_maca = [i for i, c in enumerate(cores) if saturacao(c) >= 0.25]\n",
        "    #identifica os grupos cuja saturação média é igual ou superior a 0.25, considerando-os como maçãs\n",
        "    return np.isin(rotulos, grupos_maca) #cria uma máscara indicando quais pixels pertencem aos grupos identificados como maçãs\n",
        "\n",
        "def contar_buracos(mascara):\n",
        "    #componentes pretos que não encostam na borda\n",
        "    n, rot = cv2.connectedComponents((~mascara).astype(np.uint8), connectivity=4) #identifica as regiões pretas da máscara, considerando a vizinhança de 4 pixels\n",
        "    na_borda = set(rot[0, :]) | set(rot[-1, :]) | set(rot[:, 0]) | set(rot[:, -1]) #identifica os componentes que encostam em alguma das quatro bordas da imagem\n",
        "    return len(set(range(1, n)) - na_borda) #conta os componentes pretos que não encostam na borda, considerados buracos\n",
        "\n",
        "def medidas(m):\n",
        "    return dict(objetos=contar_pedacos(m, 0.005), ruido=contar_pedacos(m) - contar_pedacos(m, 0.005),\n",
        "                buracos=contar_buracos(m), area=m.mean() * 100) #calcula a quantidade de objetos, ruídos, buracos e a porcentagem da área ocupada pela máscara\n",
        "\n",
        "REAL = {'2apples.jpg': 2, '2or4objects.jpg': 2, '7apples.jpg': 7, 'variableObjects.jpeg': 3} #define a quantidade real de maçãs em cada imagem\n",
        "\n",
        "N_ABRE, N_FECHA = 5, 9\n",
        "#define os tamanhos dos elementos estruturantes usados na abertura e no fechamento"
      ]
