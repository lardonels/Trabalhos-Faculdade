      "source": [
        "#cria um dicionário chamado MACAS (armazena informações no formato chave e valor)\n",
        "MACAS = {'2apples.jpg': 3, '2or4objects.jpg': 5, '7apples.jpg': 8, 'variableObjects.jpeg': 4}\n",
        "\n",
        "def caracteristicas(img, usar_xy): #prepara os dados que serão entregues ao K-means\n",
        "#usar_xy indica se devemos usar somente RGB ou RGB junto com as coordenadas X e Y\n",
        "    #matriz (pixels x 3) para RGB ou (pixels x 5) para RGB+XY, tudo em 0..1\n",
        "    altura, largura, _ = img.shape #obtendo as dimensões da imagem, _ é usado para dizer q não precisa guardar a quantidade de canais nessa variável\n",
        "    rgb = img[:, :, ::-1].reshape(-1, 3) / 255.0 #transforma a imagem em uma matriz de pixels no formato RGB e normaliza os valores\n",
        "    if not usar_xy: #verifica se n deve usar as coordenadas x e y\n",
        "        return rgb #K-means receberá três características por pixel\n",
        "    linhas, colunas = np.mgrid[0:altura, 0:largura] #cria duas matrizes contendo as coordenadas de cada pixel\n",
        "    x = colunas.reshape(-1, 1) / largura\n",
        "    y = linhas.reshape(-1, 1) / altura\n",
        "    return np.hstack([rgb, x, y]) #juntas todas as caracteristicas em uma unica matriz\n",
        "\n",
        "def kmeans(img, k, usar_xy): #cria a função k-means, k é a quantidade de grupos que queremos encontrar\n",
        "    dados = caracteristicas(img, usar_xy) #chama a função caracteristicas()\n",
        "    modelo = KMeans(n_clusters=k, n_init=10, random_state=42).fit(dados)\n",
        "    #KMeans(): cria o modelo de agrupamento\n",
        "    #n_clusters=k: define a quantidade de grupos que o algoritmo deve encontrar\n",
        "    #n_init=10: executa o algoritmo com 10 inicializações diferentes dos centróides, procurando uma solução melhor\n",
        "    #random_state=42: fixa a semente aleatória para que os resultados sejam reproduzíveis\n",
        "    #.fit(dados): executa o treinamento do modelo utilizando os dados dos pixels\n",
        "    #centróides são os pontos centrais de cada grupo\n",
        "    rotulos = modelo.labels_.reshape(img.shape[:2]) #recupera o grupo ao qual cada pixel pertence\n",
        "    cores = modelo.cluster_centers_[:, :3] * 255     #só a parte de cor do centróide\n",
        "    return rotulos, cores, modelo.inertia_ / len(dados)  #retorna os rótulos as cores médias dos grupos e a inércia média por pixel\n",
        "\n",
        "def pintar(rotulos, cores): #cria uma função para reconstruir a imagem utilizando as cores médias dos grupos\n",
        "    #cada pixel com a cor média do seu grupo\n",
        "    return cores[rotulos][:, :, ::-1].astype(np.uint8)\n",
        "\n",
        "def pintar_aleatorio(rotulos, k):#cria uma função para gerar uma imagem com cores diferentes para cada grupo\n",
        "    #uma cor forte por grupo, para enxergar grupos de cor parecida\n",
        "    paleta = np.random.RandomState(3).randint(40, 255, (k, 3)).astype(np.uint8)\n",
        "    return paleta[rotulos] #substitui cada rótulo pela cor correspondente da paleta"
      ]
    },
