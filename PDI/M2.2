      "source": [
        "import numpy as np\n",
        "import cv2\n",
        "import matplotlib.pyplot as plt\n",
        "import urllib.request, os, time #premite baixar direto do github as img, verificar pasta e tempo de execução\n",
        "from collections import deque #importa estrutura de dados deque, uma fila que permite adicionar e remover elementos de maneira eficiente pelas extremidades\n",
        "#usada na segmentação semeada (Seeded Segmentation), para controlar os pixels que ainda precisam ser analisados durante o crescimento da região\n",
        "from sklearn.cluster import KMeans #importa o algoritmo K-means para agrupar pixels semelhantes\n",
        "from sklearn.metrics import silhouette_score #usada para avaliar a qualidade dos agrupamentos realizados pelo K-means"
      ]
