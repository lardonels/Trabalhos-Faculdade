        "def pele_rgb(img):\n",
        "    # regra de Kovac: luz do dia OU flash\n",
        "    b = img[:, :, 0].astype(int) # recupera o canal azul e converte para inteiro\n",
        "    g = img[:, :, 1].astype(int) # recupera o canal verde e converte para inteiro\n",
        "    r = img[:, :, 2].astype(int) # recupera o canal vermelho e converte para inteiro\n",
        "    maximo = np.maximum(np.maximum(r, g), b) # identifica o maior valor entre os três canais de cor\n",
        "    minimo = np.minimum(np.minimum(r, g), b) # identifica o menor valor entre os três canais de cor\n",
        "    luz_dia = (r > 95) & (g > 40) & (b > 20) & (maximo - minimo > 15) & (np.abs(r - g) > 15) & (r > g) & (r > b) # aplica as condições para identificar tons de pele com iluminação natural\n",
        "    flash = (r > 220) & (g > 210) & (b > 170) & (np.abs(r - g) <= 15) & (r > b) & (g > b) # aplica as condições para identificar tons de pele com iluminação de flash\n",
        "    return luz_dia | flash # combina as duas regras e retorna a máscara dos pixels identificados como pele\n",
        "def pele_hsv(img):\n",
        "    # regra HSV de Kolkur et al.\n",
        "    h, s, v = rgb_para_hsv(img) # converte a imagem para HSV e separa os canais de matiz, saturação e brilho\n",
        "    return (h >= 0) & (h <= 50) & (s >= 0.23) & (s <= 0.68) # identifica os pixels dentro dos intervalos definidos para tons de pele\n",
        "ROSTOS = ['face1.jpg', 'face2.jpg', 'face3.jpeg', 'face4.jpg'] # lista os nomes das imagens dos rostos\n",
        "faces = {nome: ler(nome, 400) for nome in ROSTOS} # carrega as imagens da lista e redimensiona cada uma para 400 pixels\n",
        "mascaras_pele = {} # cria um dicionário para armazenar as máscaras de pele de cada imagem\n",
        "for nome, img in faces.items(): # percorre cada imagem do dicionário faces\n",
        "    m_rgb, m_hsv = pele_rgb(img), pele_hsv(img) # aplica os métodos RGB e HSV para identificar os pixels de pele\n",
        "    mascaras_pele[nome] = (m_rgb, m_hsv) # armazena as duas máscaras no dicionário, associadas ao nome da imagem\n",
        "    print(f'{nome}: pele RGB = {m_rgb.mean()*100:.1f}% da imagem | pele HSV = {m_hsv.mean()*100:.1f}%') # calcula e exibe a porcentagem da imagem identificada como pele em cada método\n",
        "    mostrar([img, m_rgb.astype(np.uint8), m_hsv.astype(np.uint8)], ['original', 'limiar RGB', 'limiar HSV'], tam=3.5) # exibe a imagem original e as máscaras geradas pelos dois métodos"
