        "    linhas = int(np.ceil(len(imagens) / colunas)) #calcula quantas linhas serão necessárias para organizar as imagens\n",
        "    plt.figure(figsize=(tam * colunas, tam * linhas * 0.8)) #cria a figura onde as imagens serão organizadas\n",
        "    for i, (img, tit) in enumerate(zip(imagens, titulos)): #percorrer as imagens e seus respectivos títulos\n",
        "        plt.subplot(linhas, colunas, i + 1) #posição a imagem será exibida\n",
        "        if img.ndim == 2: #verifica se a imagem possui duas dimensões\n",
