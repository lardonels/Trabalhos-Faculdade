      "source": [
        "resultados = {}#usado de novo na morfologia\n",
        "for nome, k in MACAS.items(): #percorre o dicionário MACAS\n",
        "    img = ler(nome, 500) #carrega a imagem e redimensiona para que seu maior lado tenha 500 pixels\n",
        "    t = time.time() #registra o horário inicial para medir o tempo de processamento\n",
        "    #executa o K-means da parte A, utilizando somente as características RGB\n",
        "    #retorna os rótulos dos pixels, as cores médias e a inércia média\n",
        "    rot_a, cor_a, err_a = kmeans(img, k, usar_xy=False)\n",
        "    #executa o K-means da parte B, utilizando RGB e as coordenadas X e Y\n",
        "    #retorna os rótulos dos pixels, as cores médias e a inércia média\n",
        "    rot_b, cor_b, err_b = kmeans(img, k, usar_xy=True)\n",
        "    #armazena as informações da imagem e os resultados das duas segmentações pra usar dnv na morfologia\n",
        "    resultados[nome] = dict(img=img, k=k, rot_a=rot_a, cor_a=cor_a, rot_b=rot_b, cor_b=cor_b)\n",
        "    #exibe o nome da imagem, o valor de K e o tempo total de processamento, :.1f formata o tempo para apresentar apenas uma casa decimal\n",
        "    print(f'{nome}: K={k}  tempo={time.time()-t:.1f}s')\n",
        "    #exibe cinco imagens para comparar os resultados da segmentação\n",
        "    mostrar([img, pintar(rot_a, cor_a), pintar_aleatorio(rot_a, k), pintar(rot_b, cor_b), pintar_aleatorio(rot_b, k)],\n",
        "            ['original', 'A: RGB (cor média)', 'A: RGB (grupos)', 'B: RGB+XY (cor média)', 'B: RGB+XY (grupos)'], tam=3.4)"
      ]
