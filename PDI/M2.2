        "def iou(a, b):\n",
        "    return (a & b).sum() / max((a | b).sum(), 1) #calcula a interseção sobre união entre duas máscaras, medindo o quanto elas se sobrepõem\n",
        "def contar_pedacos(mascara, area_min=0.0):\n",
        "    #componentes conectados (8-vizinhança) com área >= area_min (fração da imagem)\n",
        "    n, _, stats, _ = cv2.connectedComponentsWithStats(mascara.astype(np.uint8), connectivity=8) #identifica os componentes conectados da máscara, considerando também os pixels na diagonal\n",
        "    areas = stats[1:, cv2.CC_STAT_AREA] / mascara.size # recupera a área de cada componente, desconsiderando o fundo, e calcula sua proporção em relação à imagem\n",
        "    return int((areas >= area_min).sum()) #conta quantos componentes possuem área maior ou igual ao limite definido\n",
        "print(f'{\"imagem\":12s} {\"IoU RGB×HSV\":>12s} {\"IoU semeada×RGB\":>16s} {\"IoU semeada×HSV\":>16s} {\"pedaços RGB\":>12s} {\"pedaços HSV\":>12s}')\n",
        "#exibe os títulos das colunas da tabela de comparação\n",
        "\n",
        "for nome in ROSTOS: #percorre os nomes das imagens dos rostos\n",
        "    m_rgb, m_hsv = mascaras_pele[nome] #recupera as máscaras geradas pelos métodos RGB e HSV\n",
        "    reg = regioes[nome] #recupera a máscara gerada pelo crescimento de regiões\n",
        "\n",
        "    print(f'{nome:12s} {iou(m_rgb, m_hsv):12.2f} {iou(reg, m_rgb):16.2f} {iou(reg, m_hsv):16.2f} {contar_pedacos(m_rgb):12d} {contar_pedacos(m_hsv):12d}')\n",
        "    #exibe o nome da imagem, os valores de sobreposição entre as máscaras e a quantidade de componentes identificados em RGB e HSV"
      ]
