      "source": [
        "# imagens do GitHub da disciplina\n",
        "URL = 'https://raw.githubusercontent.com/VielF/ColabProjects/main/dataset/ImgSegTrab/'\n",
        "NOMES = ['2apples.jpg', '2or4objects.jpg', '7apples.jpg', 'variableObjects.jpeg',\n",
        "         'face1.jpg', 'face2.jpg', 'face3.jpeg', 'face4.jpg']\n",
        "for nome in NOMES:\n",
        "    if not os.path.exists(nome): #só verifica se existe no pc\n",
        "        urllib.request.urlretrieve(URL + nome, nome) #baixa as img\n",
        "\n",
        "def ler(nome, lado_max):\n",
        "    # lê em BGR e redimensiona para o maior lado ficar com lado_max pixels\n",
        "    img = cv2.imread(nome)\n",
        "    if img is None:\n",
        "        raise FileNotFoundError(f'não consegui abrir {nome}')\n",
        "    escala = lado_max / max(img.shape[:2]) #calcula o fator de redimensionamento da imagem\n",
        "    #redimensiona a imagem proporcionalmente e retorna o resultado\n",
        "    #fx e fy aplicam a escala na largura e na altura\n",
        "    #INTER_AREA é utilizado para melhorar a redução da imagem\n",
        "    return cv2.resize(img, None, fx=escala, fy=escala, interpolation=cv2.INTER_AREA)\n",
        "#percorre novamente a lista de imagens para verificar suas dimensões originais\n",
        "for nome in NOMES:\n",
        "    print(nome, cv2.imread(nome).shape) #exibe o nome do arquivo e dimensões (altura, largura e canais de cor)"
      ]
    },
