        "#cria duas funções para testar a segmentação de imagens de maçãs e uma função para testar a segmentação de rostos\n",
        "def testar_macas(caminho, k, lado_max=500):\n",
        "    img = ler(caminho, lado_max) # carrega a imagem e redimensiona para o tamanho máximo definido\n",
        "    figuras, titulos, linhas = [], [], [] # cria listas para armazenar as imagens, seus títulos e as medidas dos resultados\n",
        "    for parte, usar_xy in [('A RGB', False), ('B RGB+XY', True)]: # percorre os dois métodos de segmentação: apenas RGB e RGB combinado com XY\n",
        "        rot, cor, _ = kmeans(img, k, usar_xy) # aplica o K-means e recupera os rótulos dos grupos e suas cores médias\n",
        "        m0 = mascara_macas(rot, cor) # cria a máscara inicial identificando os grupos correspondentes às maçãs\n",
        "        m2 = fechamento(abertura(m0, N_ABRE), N_FECHA) # aplica abertura e fechamento para reduzir ruídos e preencher pequenos buracos\n",
        "        figuras += [img, pintar_aleatorio(rot, k), m0, m2] # armazena a imagem original, os grupos coloridos, a máscara inicial e a máscara tratada\n",
        "        titulos += ['original', f'{parte}: grupos (K={k})', f'{parte}: máscara', f'{parte}: abertura+fechamento'] # define os títulos das imagens\n",
        "        linhas.append((parte, medidas(m0), medidas(m2), m2)) # armazena as medidas antes e depois da morfologia e a máscara final\n",
        "    mostrar(figuras, titulos, colunas=4, tam=3.4) # exibe os resultados dos dois métodos em uma grade com quatro colunas\n",
        "\n",
        "    for parte, antes, depois, _ in linhas: # percorre os resultados de cada método\n",
        "        print(f'{parte:9s} antes:  {antes[\"objetos\"]} obj., {antes[\"ruido\"]} ruído, {antes[\"buracos\"]} buracos'\n",
        "              f' | depois: {depois[\"objetos\"]} obj., {depois[\"ruido\"]} ruído, {depois[\"buracos\"]} buracos')\n",
        "        #exibe a quantidade de objetos, ruídos e buracos antes e depois das operações morfológicas\n",
        "    print(f'dif. A×B depois da morfologia: {np.mean(linhas[0][3] != linhas[1][3])*100:.2f}%')\n",
        "    #calcula e exibe a porcentagem de pixels diferentes entre as máscaras finais dos métodos A e B\n",
        "\n",
        "def sugerir_semente(img):\n",
        "    #ponto da pele (RGB, com abertura) mais distante da borda, com peso para o centro da imagem\n",
        "    pele = abertura(pele_rgb(img), 5).astype(np.uint8)\n",
        "    #identifica os pixels de pele pelo método RGB, aplica abertura para remover ruídos e converte a máscara para uint8\n",
        "\n",
        "    if pele.sum() == 0: #verifica se nenhum pixel foi identificado como pele\n",
        "        return (img.shape[0] // 2, img.shape[1] // 2) #retorna o centro da imagem como semente padrão\n",
        "\n",
        "    dist = cv2.distanceTransform(pele, cv2.DIST_L2, 5) #calcula a distância de cada pixel de pele até o pixel mais próximo que não pertence à pele\n",
        "    linhas, colunas = np.mgrid[0:img.shape[0], 0:img.shape[1]] #cria matrizes com as coordenadas de cada pixel da imagem\n",
        "\n",
        "    d_centro = np.hypot(linhas - img.shape[0] / 2, colunas - img.shape[1] / 2) / max(img.shape[:2])\n",
        "    #calcula a distância de cada pixel até o centro da imagem e normaliza pelo maior lado\n",
        "\n",
        "    nota = dist * np.exp(-(d_centro / 0.3) ** 2) #combina a distância até a borda da região de pele com um peso que favorece pontos próximos ao centro\n",
        "\n",
        "    return tuple(int(v) for v in np.unravel_index(np.argmax(nota), nota.shape)) # encontra o pixel com maior pontuação e retorna suas coordenadas como (linha, coluna)\n",
        "\n",
        "def testar_rosto(caminho, semente=None, tol=40, lado_max=400):\n",
        "    img = ler(caminho, lado_max) if isinstance(caminho, str) else caminho\n",
        "    #carrega e redimensiona a imagem se caminho for um nome de arquivo; caso contrário, utiliza a imagem recebida\n",
        "\n",
        "    if semente is None: # verifica se nenhuma semente foi informada\n",
        "        semente = sugerir_semente(img) # calcula automaticamente uma posição adequada para iniciar o crescimento de regiões\n",
        "        print('semente sugerida (linha, coluna):', semente) # exibe as coordenadas da semente escolhida\n",
        "\n",
        "    m_rgb, m_hsv = pele_rgb(img), pele_hsv(img) # gera as máscaras de identificação de pele pelos métodos RGB e HSV\n",
        "    reg = crescimento_regioes(img, semente, tol) # aplica o crescimento de regiões usando a semente e a tolerância definidas\n",
        "\n",
        "    plt.figure(figsize=(4.5, 4.5))            # cria uma figura para exibir a imagem e a posição da semente\n",
        "    plt.imshow(img[:, :, ::-1]); plt.plot(semente[1], semente[0], 'g+', ms=18, mew=3) # converte a imagem de BGR para RGB e marca a semente em verde no gráfico\n",
        "\n",
        "    plt.title('eixos em pixels: x = coluna, y = linha', fontsize=10); plt.show() # define o título explicando os eixos e exibe a imagem\n",
        "\n",
        "    sobreposta = img.copy(); sobreposta[~reg] = (sobreposta[~reg] * 0.25).astype(np.uint8)\n",
        "    #cria uma cópia da imagem e escurece os pixels que não pertencem à região identificada\n",
        "\n",
        "    mostrar([m_rgb.astype(np.uint8), m_hsv.astype(np.uint8), reg.astype(np.uint8), sobreposta],\n",
        "            ['limiar RGB', 'limiar HSV', f'semeada (tol={tol})', 'semeada sobre a imagem'], tam=3.3)\n",
        "    #exibe as máscaras RGB e HSV, a região segmentada e sua sobreposição na imagem original\n",
        "\n",
        "    print(f'pele RGB {m_rgb.mean()*100:.1f}% | pele HSV {m_hsv.mean()*100:.1f}% | região {reg.mean()*100:.1f}% da imagem')\n",
        "    #exibe a porcentagem da imagem identificada como pele ou pertencente à região segmentada\n",
        "\n",
        "    print(f'IoU RGB×HSV {iou(m_rgb, m_hsv):.2f} | semeada×RGB {iou(reg, m_rgb):.2f} | semeada×HSV {iou(reg, m_hsv):.2f}')\n",
        "    #exibe os valores de sobreposição entre as máscaras RGB, HSV e a segmentação por crescimento de regiões\n",
        "\n",
        "    return reg #retorna a máscara final da região segmentada"
      ]
