        "def crescimento_regioes(img, semente, tolerancia):\n",
        "    #semente = (linha, coluna, tolerancia = diferença máxima por canal (0..255)\n",
        "\n",
        "    altura, largura, _ = img.shape #recupera a altura e a largura da imagem\n",
        "    imagem = img.astype(float) #converte os valores dos pixels para float, permitindo cálculos com casas decimais\n",
        "    visitado = np.zeros((altura, largura), dtype=bool) #cria uma matriz para marcar os pixels que já foram visitados\n",
        "    regiao = np.zeros((altura, largura), dtype=bool) #cria uma máscara para armazenar os pixels que pertencem à região\n",
        "\n",
        "    soma = imagem[semente].copy() #inicia a soma com a cor do pixel escolhido como semente\n",
        "    quantidade = 1 #define a quantidade inicial de pixels da região\n",
        "    fila = deque([semente]) #cria uma fila começando pela posição da semente\n",
        "    visitado[semente] = True #marca a semente como visitada\n",
        "\n",
        "    while fila: #continua enquanto houver pixels para analisar na fila\n",
        "        linha, coluna = fila.popleft() #remove o próximo pixel da fila\n",
        "        media = soma / quantidade #calcula a média das cores dos pixels aceitos na região\n",
        "\n",
        "        if np.all(np.abs(imagem[linha, coluna] - media) < tolerancia): #verifica se a diferença entre a cor do pixel e a média está dentro da tolerância\n",
        "            regiao[linha, coluna] = True #adiciona o pixel à região\n",
        "            soma += imagem[linha, coluna]#atualiza a soma das cores para recalcular a média\n",
        "            quantidade += 1 #tualiza a quantidade de pixels pertencentes à região\n",
        "\n",
        "            for dl, dc in [(1, 0), (-1, 0), (0, 1), (0, -1)]: #percorre os quatro vizinhos: baixo, cima, direita e esquerda\n",
        "                nl, nc = linha + dl, coluna + dc #calcula a posição do vizinho\n",
        "\n",
        "                if 0 <= nl < altura and 0 <= nc < largura and not visitado[nl, nc]: #verifica se o vizinho está dentro da imagem e ainda não foi visitado\n",
        "                    visitado[nl, nc] = True #marca o vizinho como visitado\n",
        "                    fila.append((nl, nc)) #adiciona o vizinho à fila para ser analisado\n",
        "\n",
        "    return regiao #retorna a máscara indicando os pixels que fazem parte da região"
      ]
    },
